<?xml version="1.0" encoding="UTF-8"?>
<!-- Office Math cases for the corrections of docxdriver behaviour (doc.go). -->
<doc xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
<!-- on/off: degHide -->
<m:oMath><m:rad><m:radPr><m:degHide/></m:radPr><m:deg><m:r><m:t>3</m:t></m:r></m:deg><m:e><m:r><m:t>x</m:t></m:r></m:e></m:rad><m:rad><m:radPr><m:degHide m:val="on"/></m:radPr><m:deg><m:r><m:t>3</m:t></m:r></m:deg><m:e><m:r><m:t>x</m:t></m:r></m:e></m:rad><m:rad><m:radPr><m:degHide m:val="off"/></m:radPr><m:deg><m:r><m:t>3</m:t></m:r></m:deg><m:e><m:r><m:t>x</m:t></m:r></m:e></m:rad><m:rad><m:radPr><m:degHide m:val="x"/></m:radPr><m:deg><m:r><m:t>3</m:t></m:r></m:deg><m:e><m:r><m:t>x</m:t></m:r></m:e></m:rad></m:oMath>
<!-- on/off: n-ary limits and control properties -->
<m:oMath><m:nary><m:naryPr><m:subHide/></m:naryPr><m:sub><m:r><m:t>a</m:t></m:r></m:sub><m:sup><m:r><m:t>b</m:t></m:r></m:sup><m:e><m:r><m:t>f</m:t></m:r></m:e></m:nary><m:nary><m:naryPr><m:supHide m:val="off"/></m:naryPr><m:sub><m:r><m:t>a</m:t></m:r></m:sub><m:sup><m:r><m:t>b</m:t></m:r></m:sup><m:e><m:r><m:t>f</m:t></m:r></m:e></m:nary><m:nary><m:naryPr><m:subHide m:val="true"/></m:naryPr><m:sub><m:r><m:t>a</m:t></m:r></m:sub><m:sup><m:r><m:t>b</m:t></m:r></m:sup><m:e><m:r><m:t>f</m:t></m:r></m:e></m:nary><m:nary><m:naryPr><m:chr m:val="∑"/><m:ctrlPr><w:rPr><w:b w:val="x"/><w:i w:val="true"/></w:rPr></m:ctrlPr></m:naryPr><m:sub><m:r><m:t>a</m:t></m:r></m:sub><m:sup><m:r><m:t>b</m:t></m:r></m:sup><m:e><m:r><m:t>f</m:t></m:r></m:e></m:nary><m:nary><m:naryPr><m:ctrlPr><w:rPr><w:b w:val="on"/><w:i w:val="false"/></w:rPr></m:ctrlPr></m:naryPr><m:sub><m:r><m:t>a</m:t></m:r></m:sub><m:sup><m:r><m:t>b</m:t></m:r></m:sup><m:e><m:r><m:t>f</m:t></m:r></m:e></m:nary></m:oMath>
<!-- on/off: normal text -->
<m:oMath><m:r><m:rPr><m:nor m:val="0"/></m:rPr><m:t>ab</m:t></m:r><m:r><m:rPr><m:nor m:val="on"/></m:rPr><m:t>cd</m:t></m:r><m:r><m:rPr><m:nor m:val="off"/></m:rPr><m:t>e f</m:t></m:r></m:oMath>
<!-- delimiter separators and names -->
<m:oMath><m:d><m:e><m:r><m:t>a</m:t></m:r></m:e><m:e><m:r><m:t>b</m:t></m:r></m:e></m:d><m:d><m:dPr><m:sepChr m:val=";"/></m:dPr><m:e><m:r><m:t>a</m:t></m:r></m:e><m:e><m:r><m:t>b</m:t></m:r></m:e></m:d><m:d><m:dPr><m:begChr m:val=""/><m:endChr m:val="⟩"/></m:dPr><m:e><m:r><m:t>x</m:t></m:r></m:e></m:d><m:d><m:dPr><m:begChr m:val="⌈"/><m:endChr m:val="⌋"/></m:dPr><m:e><m:r><m:t>y</m:t></m:r></m:e></m:d><m:d><m:dPr><m:begChr m:val="⟨"/><m:endChr m:val=""/></m:dPr><m:e><m:r><m:t>z</m:t></m:r></m:e></m:d></m:oMath>
<!-- bar and group character defaults -->
<m:oMath><m:bar><m:e><m:r><m:t>a</m:t></m:r></m:e></m:bar><m:bar><m:barPr><m:pos m:val="top"/></m:barPr><m:e><m:r><m:t>b</m:t></m:r></m:e></m:bar><m:bar><m:barPr/><m:e><m:r><m:t>c</m:t></m:r></m:e></m:bar><m:groupChr><m:e><m:r><m:t>d</m:t></m:r></m:e></m:groupChr><m:groupChr><m:groupChrPr><m:pos m:val="top"/></m:groupChrPr><m:e><m:r><m:t>e</m:t></m:r></m:e></m:groupChr><m:groupChr><m:groupChrPr><m:chr m:val="→"/><m:pos m:val="top"/></m:groupChrPr><m:e><m:r><m:t>g</m:t></m:r></m:e></m:groupChr><m:groupChr><m:groupChrPr><m:chr m:val="⏞"/></m:groupChrPr><m:e><m:r><m:t>h</m:t></m:r></m:e></m:groupChr></m:oMath>
<!-- accent characters -->
<m:oMath><m:acc><m:accPr><m:chr m:val="→"/></m:accPr><m:e><m:r><m:t>v</m:t></m:r></m:e></m:acc><m:acc><m:accPr><m:chr m:val="̲"/></m:accPr><m:e><m:r><m:t>u</m:t></m:r></m:e></m:acc><m:acc><m:accPr><m:chr m:val="⃡"/></m:accPr><m:e><m:r><m:t>w</m:t></m:r></m:e></m:acc></m:oMath>
<!-- pre-scripts -->
<m:oMath><m:sPre><m:sub><m:r><m:t>1</m:t></m:r></m:sub><m:sup><m:r><m:t>2</m:t></m:r></m:sup><m:e><m:r><m:t>X</m:t></m:r></m:e></m:sPre><m:sPre><m:sub/><m:sup><m:r><m:t>n</m:t></m:r></m:sup><m:e><m:r><m:t>Y</m:t></m:r></m:e></m:sPre><m:sPre><m:sub/><m:sup/><m:e><m:r><m:t>Z</m:t></m:r></m:e></m:sPre></m:oMath>
<!-- linear fraction -->
<m:oMath><m:f><m:fPr><m:type m:val="lin"/></m:fPr><m:num><m:r><m:t>a+b</m:t></m:r></m:num><m:den><m:r><m:t>2</m:t></m:r></m:den></m:f></m:oMath>
<!-- phantoms -->
<m:oMath><m:phant><m:e><m:r><m:t>a</m:t></m:r></m:e></m:phant><m:phant><m:phantPr><m:show m:val="0"/></m:phantPr><m:e><m:r><m:t>b</m:t></m:r></m:e></m:phant><m:phant><m:phantPr><m:show m:val="on"/></m:phantPr><m:e><m:r><m:t>c</m:t></m:r></m:e></m:phant><m:phant><m:phantPr><m:show/><m:zeroWid/></m:phantPr><m:e><m:r><m:t>d</m:t></m:r></m:e></m:phant></m:oMath>
<!-- numbers in mixed text -->
<m:oMath><m:r><m:t>12a3.5b</m:t></m:r><m:r><m:t>x.</m:t></m:r><m:r><m:t>.5+1</m:t></m:r><m:r><m:t>a..b</m:t></m:r></m:oMath>
<!-- LaTeX specials -->
<m:oMath><m:r><m:t>a&amp;b^c~d</m:t></m:r><m:r><m:rPr><m:sty m:val="p"/></m:rPr><m:t>if a&amp;b^c~d</m:t></m:r></m:oMath>
<!-- empty runs -->
<m:oMath><m:r><m:rPr><m:sty m:val="p"/></m:rPr><m:t></m:t></m:r><m:r><m:delText></m:delText></m:r><m:r><m:rPr><m:nor/></m:rPr></m:r><m:r><m:t>k</m:t></m:r></m:oMath>
</doc>
