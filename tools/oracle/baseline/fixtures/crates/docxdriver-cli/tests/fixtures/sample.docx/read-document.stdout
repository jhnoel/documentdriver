    "markup": "<section data-docx-section=\"1\">\n<h1 id=\"19FA2AE0\" data-docx-style=\"Heading1\">Service Agreement</h1>\n<p id=\"2D4D22AD\" data-docx-style=\"FirstParagraph\">Payment is due within thirty days of invoice.</p>\n<h2 id=\"4E9D2B67\" data-docx-style=\"Heading2\">Fees</h2>\n<p id=\"01DB86EE\" data-docx-style=\"FirstParagraph\">The kickoff fee is 5000.</p>\n</section>",
