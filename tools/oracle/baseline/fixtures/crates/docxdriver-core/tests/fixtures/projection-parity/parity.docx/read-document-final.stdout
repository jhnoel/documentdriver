    "markup": "<section data-docx-section=\"1\" data-docx-first-page=\"true\">\n<header>\n<p>header default</p>\n</header>\n<header data-docx-kind=\"first\">\n<p>header first</p>\n</header>\n<header data-docx-kind=\"even\">\n<p>header even</p>\n</header>\n<footer>\n<p>footer default</p>\n</footer>\n<footer data-docx-kind=\"first\">\n<p>footer first</p>\n</footer>\n<footer data-docx-kind=\"even\">\n<p>footer even</p>\n</footer>\n<p id=\"11111111\" data-docx-style=\"CustomStyle\"><b>Bold</b><i> italic</i><u> underline</u><s> strike</s><sup> super</sup><sub> sub</sub><a href=\"https://example.com/?a=1&amp;b=2\">Safe link</a><a href=\"#\" data-docx-href=\"custom-scheme:opaque-target\">Opaque link</a><a href=\"#bookmark\">Internal link</a></p>\n<p id=\"22222222\"><span data-docx-field=\"AUTHOR\">Author result</span><span data-docx-field=\"REF source\">Complex result</span>Commented<b> changed-format</b><span style=\"font-weight:normal;\"> neutral-format</span></p>\n<ol data-docx-list=\"42\" data-docx-level=\"0\" start=\"3\" type=\"I\"><li data-docx-marker=\"III.\"><p id=\"33333333\">Roman item</p><ol data-docx-list=\"42\" data-docx-level=\"1\" start=\"1\" type=\"a\"><li data-docx-marker=\"a)\"><p id=\"33333334\">Nested item</p></li></ol></li><li data-docx-marker=\"IV.\"><p id=\"33333335\">Next item</p></li></ol>\n<p id=\"44444444\">Common inserted<sup data-docx-note=\"footnote\" data-docx-note-id=\"7\"><a>1</a></sup><sup data-docx-note=\"endnote\" data-docx-note-id=\"9\"><a>1</a></sup><sup data-docx-note=\"endnote\" data-docx-note-id=\"11\"><a>2</a></sup></p>\n<p id=\"55555555\"><img src=\"assets/i1.png\" data-docx-image-part=\"word/media/image.png\" width=\"32\" height=\"24\" alt=\"Available picture\"><span data-docx-image-unavailable=\"true\" data-docx-image-rid=\"opaque\" data-docx-image-part=\"word/media/image.emf\" data-docx-image-width=\"48\" data-docx-image-height=\"36\" data-docx-image-alt=\"Opaque picture\">Opaque picture</span></p>\n<p id=\"66666666\">Unicode 😀