        "durableId": "10000008",
        "id": "2",
        "replies": [],
        "root": {
          "author": "Legal Reviewer",
          "date": "2000-01-01T00:00:00Z",
          "paraId": "10000008",
          "text": "Five years is acceptable for general business information, but trade secrets should remain protected for so long as they qualify as trade secrets under applicable law."
        },
        "status": "open"
      },
      {
